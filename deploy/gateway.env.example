# Alveron automation gateway — variable NAMES only. Copy to deploy/gateway.env and chmod 600.
# Never commit real values.
#
# The gateway runs ONLY on the host under systemd unit alveron-automation-gateway and binds
# loopback (GATEWAY_HOST=127.0.0.1) — it is never exposed to the Internet. n8n (Docker, host
# networking) reaches it at http://127.0.0.1:8787.

NODE_ENV=production

# Remote https-only API base; loopback URLs need no override. Plain-http remote URLs are refused.
ALVERON_API_BASE_URL=https://api.alveronfashion.com/api
ALVERON_ALLOW_REMOTE_API=true

# Dedicated Supabase service account (profiles.role='admin', active employee). Set the password to a
# post-mustChangePassword value. The account must exist before live runs.
ALVERON_SERVICE_EMAIL=
ALVERON_SERVICE_PASSWORD=

GATEWAY_API_KEY=
ADMIN_ALERT_EMAIL=

LEDGER_DATABASE_URL=sqlite:./data/ledger.sqlite
# Transactional email. Production uses `resend`; `unknown` fails closed until credentials exist.
# Set ALL THREE Resend values from the operator secret manager (never commit them).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Alveron Fashion
RESEND_TIMEOUT_MS=10000
TELEGRAM_PROVIDER=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_TIMEOUT_MS=10000
FEATURE_ENABLE_ALVERON_WRITES=false
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# live | test | disabled — customer-email safety boundary (see the runbook).
ALVERON_AUTOMATION_MODE=live
# Bounded order scans: GET /orders?limit=&offset= with a hard page ceiling.
ALVERON_ORDER_PAGE_SIZE=100
ALVERON_ORDER_MAX_PAGES=20
SHIPPING_SLA_HOURS=48

# Finance automation (display timezone + deterministic anomaly thresholds; 0 disables a signal).
FINANCE_TIMEZONE=Africa/Lagos
FINANCE_EXPENSE_SPIKE_THRESHOLD=0
FINANCE_REFUND_RATE_THRESHOLD_PERCENT=0
FINANCE_REVENUE_DROP_THRESHOLD_PERCENT=0
FINANCE_RECONCILIATION_ISSUE_THRESHOLD=0
FINANCE_PAYABLE_SPIKE_THRESHOLD=0
FINANCE_MISSING_COST_THRESHOLD=0
FINANCE_LARGE_PAYABLE_THRESHOLD=0

# Import-time schedule tuning, consumed by node scripts/configure-workflow.mjs (host shell only).
PAID_ORDER_POLL_MINUTES=15
REFERRAL_QUALIFICATION_POLL_MINUTES=60
PRODUCT_REQUEST_POLL_MINUTES=15
LOW_STOCK_POLL_MINUTES=360
ORDER_OPERATIONS_POLL_MINUTES=60
PAYMENT_RECONCILIATION_POLL_MINUTES=15
SHIPPING_SLA_POLL_MINUTES=60
SYSTEM_HEALTH_POLL_MINUTES=15
FINANCE_DAILY_REPORT_POLL_MINUTES=1440
FINANCE_WEEKLY_REPORT_POLL_MINUTES=10080
FINANCE_RECONCILIATION_POLL_MINUTES=15
FINANCE_EXPENSE_REVIEW_POLL_MINUTES=30
FINANCE_SUPPLIER_PAYABLES_POLL_MINUTES=1440
FINANCE_REVIEW_DIGEST_POLL_MINUTES=1440
FINANCE_ANOMALY_MONITOR_POLL_MINUTES=1440
FINANCE_EVENTS_CONSUMER_POLL_MINUTES=15
AUTOMATION_EVENTS_POLL_MINUTES=15
DAILY_OPERATIONS_POLL_MINUTES=1440