# Template only — the operator copies this to /etc/nginx/sites-available/n8n.alveronfashion.com
# and obtains a real certificate (e.g. certbot). No TLS/procurement happens from this repository.
#
# Exposed: n8n UI/API only. The automation gateway must NOT be reachable from here or from the
# public Internet: it binds 127.0.0.1 on its host and is reachable only from the n8n process.

server {
    listen 80;
    server_name n8n.alveronfashion.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name n8n.alveronfashion.com;

    # ssl_certificate     /etc/letsencrypt/live/n8n.alveronfashion.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/n8n.alveronfashion.com/privkey.pem;

    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:5678;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}

# Intentionally NOT proxied here (must stay private):
#   Alveron API (4000) — reached by the gateway, not by n8n or the Internet
#   storefront (3000)  — served by its own existing stack
#   gateway port (8787)— loopback on the automation host only