# Alveron n8n deployment — variable NAMES only. Copy to deploy/.env and chmod 600.
# Never commit real values.

# Public identity (nginx terminates TLS on the host in front of 127.0.0.1:5678)
N8N_HOST=n8n.alveronfashion.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.alveronfashion.com/
GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos

# n8n encryption key: openssl rand -hex 32 — stable across restarts; back it up independently.
N8N_ENCRYPTION_KEY=

# n8n database (Postgres container, published only on the host loopback)
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# n8n owner credentials (strong password + MFA) are set interactively in the browser on first launch.