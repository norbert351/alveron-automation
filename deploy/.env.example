# Alveron automation deployment — variable NAMES only. Values come from the operator's secret store.
# Never commit real values.

# n8n (container)
N8N_HOST=n8n.alveronfashion.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.alveronfashion.com/
GENERIC_TIMEZONE=UTC
TZ=UTC
N8N_ENCRYPTION_KEY=
# n8n user-management owner credentials are set interactively on first launch (not in this file).

# Automation gateway (host process)
NODE_ENV=development
ALVERON_API_BASE_URL=
ALVERON_SERVICE_EMAIL=
ALVERON_SERVICE_PASSWORD=
GATEWAY_API_KEY=
ADMIN_ALERT_EMAIL=
LEDGER_DATABASE_URL=sqlite:./data/ledger.sqlite
EMAIL_PROVIDER=unknown
FEATURE_ENABLE_ALVERON_WRITES=false
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Non-secret n8n inputs
GATEWAY_BASE_URL=http://127.0.0.1:8787
PAID_ORDER_POLL_MINUTES=15
REFERRAL_QUALIFICATION_POLL_MINUTES=60