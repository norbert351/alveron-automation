        "jsCode": "const raw = $input.first().json; const b = raw.body && typeof raw.body === 'object' && !Array.isArray(raw.body) ? raw.body : raw; const categories = ['CONFIGURATION_ERROR','AUTHENTICATION_ERROR','AUTHORIZATION_ERROR','RATE_LIMITED','ALVERON_SERVER_ERROR','NETWORK_ERROR','INVALID_RESPONSE','VALIDATION_FAILED','LEDGER_ERROR','UNKNOWN_ERROR']; if (b && (b.status === 'completed' || b.status === 'duplicate')) { return [{ json: { status: b.status, windowId: b.windowId, sideEffectInvoked: b.sideEffectInvoked === true, processedCount: b.processedCount ?? null, duplicate: b.duplicate ?? null } }]; } const category = categories.includes(b?.failureCategory) ? b.failureCategory : 'UNKNOWN_ERROR'; const transient = ['RATE_LIMITED','ALVERON_SERVER_ERROR','NETWORK_ERROR'].includes(category); throw new Error('REFERRAL_QUALIFICATION_FAILED|' + category + '|' + category + '|' + transient);"
