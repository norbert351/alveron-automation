# Development examples only. Do not paste real credentials into repository files.
# Supply secret values to the process from the operator's secret manager.
NODE_ENV=development
ALVERON_API_BASE_URL=http://localhost:4000/api
ALVERON_SERVICE_EMAIL=
ALVERON_SERVICE_PASSWORD=
GATEWAY_API_KEY=
FEATURE_ENABLE_ALVERON_WRITES=false
# Transactional email. `resend` is the production server-side provider; `console` is simulated
# (development only); `unknown` fails closed. `resend` requires ALL THREE values below.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Alveron Fashion
RESEND_TIMEOUT_MS=10000
ADMIN_ALERT_EMAIL=
LOG_LEVEL=info
LEDGER_DATABASE_URL=sqlite:./data/ledger.sqlite
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=2
HTTP_MAX_REQUESTS_PER_MINUTE=40
# Bounded order scans: `GET /orders?limit=&offset=` with a hard page ceiling (no unbounded reads).
ALVERON_ORDER_PAGE_SIZE=100
ALVERON_ORDER_MAX_PAGES=20
# Telegram is disabled until both trusted values are supplied through the operator's secret manager.
TELEGRAM_PROVIDER=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_TIMEOUT_MS=10000
# Customer-facing automation safety boundary:
#   live     = normal configured provider behavior.
#   test     = customer confirmation is intercepted and simulated; admin Telegram alerts still run.
#   disabled = customer confirmation is never sent (fails closed).
# Never mutates Alveron and never fabricates data. Mode-scoped ledger keys stop a test/disabled
# run from suppressing a later live send.
ALVERON_AUTOMATION_MODE=live
# Paid orders not shipped within this many hours raise an operational shipping-SLA alert.
SHIPPING_SLA_HOURS=48
PAID_ORDER_POLL_MINUTES=15
REFERRAL_QUALIFICATION_POLL_MINUTES=60
PRODUCT_REQUEST_POLL_MINUTES=15
LOW_STOCK_POLL_MINUTES=360
ORDER_OPERATIONS_POLL_MINUTES=60
PAYMENT_RECONCILIATION_POLL_MINUTES=15
SHIPPING_SLA_POLL_MINUTES=60
SYSTEM_HEALTH_POLL_MINUTES=15
# Finance automation. Alveron remains the financial source of truth; n8n only monitors/reports.
# Timezone is display-only. Anomaly thresholds are deterministic monitoring gates; 0 disables a signal.
FINANCE_TIMEZONE=Africa/Lagos
FINANCE_EXPENSE_SPIKE_THRESHOLD=0
FINANCE_REFUND_RATE_THRESHOLD_PERCENT=0
FINANCE_REVENUE_DROP_THRESHOLD_PERCENT=0
FINANCE_RECONCILIATION_ISSUE_THRESHOLD=0
FINANCE_PAYABLE_SPIKE_THRESHOLD=0
FINANCE_MISSING_COST_THRESHOLD=0
FINANCE_LARGE_PAYABLE_THRESHOLD=0
# Import-time schedule tuning (consumed by node scripts/configure-workflow.mjs; minutes, 5-1440).
FINANCE_DAILY_REPORT_POLL_MINUTES=1440
FINANCE_WEEKLY_REPORT_POLL_MINUTES=10080
FINANCE_RECONCILIATION_POLL_MINUTES=15
FINANCE_EXPENSE_REVIEW_POLL_MINUTES=30
FINANCE_SUPPLIER_PAYABLES_POLL_MINUTES=1440
FINANCE_REVIEW_DIGEST_POLL_MINUTES=1440
FINANCE_ANOMALY_MONITOR_POLL_MINUTES=1440
FINANCE_EVENTS_CONSUMER_POLL_MINUTES=15
# Automation outbox consumer (product-request status + order-issue admin alerts).
AUTOMATION_EVENTS_POLL_MINUTES=15
# One operational digest per business day (finance figures stay with the finance workflows).
DAILY_OPERATIONS_POLL_MINUTES=1440
