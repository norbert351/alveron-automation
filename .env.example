# Development examples only. Do not paste real credentials into repository files.
# Supply secret values to the process from the operator's secret manager.
NODE_ENV=development
ALVERON_API_BASE_URL=http://localhost:4000/api
ALVERON_SERVICE_EMAIL=
ALVERON_SERVICE_PASSWORD=
GATEWAY_API_KEY=
FEATURE_ENABLE_ALVERON_WRITES=false
EMAIL_PROVIDER=unknown
ADMIN_ALERT_EMAIL=
LOG_LEVEL=info
LEDGER_DATABASE_URL=sqlite:./data/ledger.sqlite
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=2
HTTP_MAX_REQUESTS_PER_MINUTE=40
# Non-secret n8n configuration; gateway key belongs in n8n Header Auth credentials.
GATEWAY_BASE_URL=http://127.0.0.1:8787
PAID_ORDER_POLL_MINUTES=15
REFERRAL_QUALIFICATION_POLL_MINUTES=60
